# SERVER
PORT=5000
NODE_ENV=development

# DATABASE (XAMPP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library

# JWT
JWT_SECRET=perpusku-super-secret-key-ganti-ini-di-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=perpusku-refresh-secret-ganti-juga
JWT_REFRESH_EXPIRES_IN=7d

# UPLOAD
UPLOAD_PATH=uploads
MAX_FILE_SIZE=2097152

# FRONTEND
CLIENT_URL=http://localhost:5173